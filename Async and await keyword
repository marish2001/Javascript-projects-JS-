
function getusername(name)
{
    return new Promise((resolve,reject)=>
    {
        console.log(" Get the User name",name)
        setTimeout(()=>
        {
            resolve({id:1,name:"Marish"})
        },2000)
    })
}

function getsubscribename(subscribename)
{
    return new Promise((resolve,reject)=>
    {
        console.log("Got the subscription name for",subscribename.name)
        setTimeout(()=>
        {
            resolve(
                {id :1, ottsubscription: "Hotstar", amount : 200}
        ,4000)
        })
