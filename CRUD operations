async function addapidetails()
{
    const response = await fetch("https://mimic-server-api.vercel.app/quotes",
        {
            method : 'POST',
            headers:
            {
                'Content-type': 'application/json',
            },
            body: JSON.stringify
            ({
                Author : "Dr Nedunchelian Ramanujam",
                Quotes : "Mathematics is the best key element for an array"
            })

        }
    )
    const data = await response.json()
    console.log(data)
}

addapidetails()

